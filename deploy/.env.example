# Copy to deploy/.env, fill in, chmod 600. deploy/.env is gitignored.
#
# These are broker credentials. They belong on the server and nowhere else:
# not in the repository, not in a shell command (shell history), not in a
# terminal you screen-share.

TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# paper | live  -- and API_PORT must agree: 4002 for paper, 4001 for live.
TRADING_MODE=paper
API_PORT=4002

# yes until the smoke test passes and you have decided to trade.
READ_ONLY_API=yes

TIME_ZONE=Europe/Helsinki
AUTO_RESTART_TIME=03:00 AM

# Leave empty to disable VNC entirely. Set it only while debugging a login.
VNC_SERVER_PASSWORD=
