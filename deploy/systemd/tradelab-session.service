[Unit]
Description=Tradelab daily session
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=tradelab
WorkingDirectory=/opt/tradelab
EnvironmentFile=/opt/tradelab/deploy/.env
ExecStart=/opt/tradelab/.venv/bin/python scripts/paper_session.py

# The run touches the state database and the repository working tree, and
# nothing else on the machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tradelab/state /opt/tradelab/data
